---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { stepsForGuide } from '@docsandeye/core';
import { config, maintainer, model } from 'virtual:docsandeye/model';
import ConsentBar from '../components/ConsentBar.astro';
import { guideDescription } from '../description.ts';
import ProfileData from '../components/ProfileData.astro';
import ProfileForm from '../components/ProfileForm.astro';
import { itemsForGuide } from '@docsandeye/core/interactive';
import { checkRefs, onlyIf, whenAttr } from '../interactive-view.ts';
import { guideForRoutePattern, guideIndexPagination, partsCount, stepHref, withBase } from '../view.ts';

const guide = guideForRoutePattern(config.guides, Astro.routePattern);
if (!guide) {
	throw new Error(`starlight-docsandeye: no guide declared for route ${Astro.routePattern}`);
}
const steps = stepsForGuide(model, guide.id);
const base = import.meta.env.BASE_URL;
// Only the questions that belong to this guide (`profile[].guides`).
const profile = itemsForGuide(model.config.profile, guide.id);
// The index has no "Previous"; its "Next" is the first step.
const { prev, next } = guideIndexPagination(guide, steps, base);
---

<StarlightPage
	frontmatter={{ id: guide.id, order: 0, title: guide.title, description: guideDescription(guide.title, steps.length), tableOfContents: false, prev, next }}
	docsandeye={{ kind: 'guide', guideId: guide.id }}
>
	<p class="docsi-guide-intro">
		{steps.length === 1
			? 'One step. It lists its parts, tools and safety notes.'
			: `${steps.length} steps. Follow them in order; each step lists its parts, tools and safety notes.`}
	</p>
	<ProfileData items={profile} />
	<ProfileForm guideId={guide.id} items={profile} />
	<ol class="docsi-guide-steps">
		{
			steps.map((step, i) => {
				const checks = checkRefs(step);
				return (
					<li
						data-step={step.id}
						data-when={whenAttr(step.when)}
						data-when-mode={step.when ? 'skip' : undefined}
						data-checks={checks ? JSON.stringify(checks) : undefined}
					>
						<span class="docsi-step-num" aria-hidden="true">
							{i + 1}
						</span>
						<a href={stepHref(guide, step.id, base)}>{step.title}</a>
						<span class="docsi-parts-count">
							{partsCount(step)} {partsCount(step) === 1 ? 'part' : 'parts'}
						</span>
						{step.when && <span class="docsi-when-inline">{onlyIf(step.when, profile)}</span>}
						{step.when && (
							<span class="docsi-skip-note" hidden>
								(not for your setup)
							</span>
						)}
						{checks && (
							<span class="docsi-checked-mark" hidden>
								✓ checked
							</span>
						)}
					</li>
				);
			})
		}
	</ol>
	{
		maintainer && (
			<p class="docsi-maintainer">
				Maintainers: <a href={withBase('/reshoot/', base)}>reshoot dashboard</a>
			</p>
		)
	}
	<ConsentBar />
</StarlightPage>

<script>
	import '../elements/guide.ts';
</script>
