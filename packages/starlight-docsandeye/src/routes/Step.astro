---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { stepsForGuide } from '@docsandeye/core';
import { getEntry } from 'astro:content';
import * as docsi from 'virtual:docsandeye/model';
import { buildDate, carbon, config, maintainer, model, renderManifest, staleness } from 'virtual:docsandeye/model';
import StepPage from '../components/StepPage.astro';
import { guideForRoutePattern, sidebarTargetHref, slugLabel, stepPagination, type PageLink, type SidebarTarget } from '../view.ts';

export function getStaticPaths({ routePattern }: { routePattern: string }) {
	const guide = guideForRoutePattern(config.guides, routePattern);
	if (!guide) return [];
	return stepsForGuide(model, guide.id).map((step) => ({
		params: { step: step.id },
		props: { guideId: guide.id, stepId: step.id },
	}));
}

const { guideId, stepId } = Astro.props as { guideId: string; stepId: string };
const guide = config.guides.find((g) => g.id === guideId);
const step = model.steps.get(stepId);
if (!guide || !step) {
	throw new Error(`starlight-docsandeye: unknown guide/step ${guideId}/${stepId}`);
}

// The step's own frontmatter travels through StarlightPage so a `docs` collection
// extended with `stepFrontmatterSchema` validates it (and plain Starlight strips it).
const { body: _body, ...stepFrontmatter } = step;

// Prev/next: the neighbouring steps; the last step leads on to the sidebar
// entry after the guide's own (a page's label is its title).
const base = import.meta.env.BASE_URL;
const steps = stepsForGuide(model, guide.id);
const target: SidebarTarget | undefined = (docsi as { sidebarNext?: Record<string, SidebarTarget> }).sidebarNext?.[guide.id];
let after: PageLink | undefined;
const afterHref = target ? sidebarTargetHref(target, base) : undefined;
if (target && afterHref) {
	let label = target.label;
	if (label === undefined && target.slug !== undefined) {
		const entry = await getEntry('docs', target.slug).catch(() => undefined);
		label = (entry?.data as { title?: string } | undefined)?.title ?? slugLabel(target.slug);
	}
	after = { link: afterHref, label: label ?? afterHref };
}
const { prev, next } = stepPagination(guide, steps, step.id, base, after);
---

<StarlightPage
	frontmatter={{ ...stepFrontmatter, title: step.title, tableOfContents: false, prev, next }}
	docsandeye={{ kind: 'step', guideId: guide.id, stepId: step.id }}
>
	<StepPage
		guide={guide}
		step={step}
		model={model}
		staleness={staleness}
		renderManifest={renderManifest}
		carbon={carbon}
		buildDate={buildDate}
		maintainer={maintainer}
		pathname={Astro.url.pathname}
	/>
</StarlightPage>
