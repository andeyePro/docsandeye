---
/**
 * "Not saved" notice, shown (by `consent.ts`) after the reader chose "Don't
 * save": their answers last only for this visit.
 */
---

<p class="docsi-consent-notice" role="status" hidden>
	Not saved: your answers are lost when you leave.
	<button type="button" data-consent-action="allow">Allow saving</button>
	<button type="button" data-consent-action="hide">Hide this for now</button>
</p>
