---
import type { ProjectModel, StalenessReport, Step } from '@docsandeye/core';
import * as docsi from 'virtual:docsandeye/model';
import type { MediaManifest, RenderManifest } from '../data.ts';
import { componentName, renderJobFor, renderPresentation, renderUrl } from '../view.ts';
import MediaItem from './MediaItem.astro';
import StalenessDetails from './StalenessDetails.astro';
import VideoBlock from './VideoBlock.astro';

interface Props {
	step: Step;
	model: ProjectModel;
	staleness: StalenessReport;
	renderManifest: RenderManifest | null;
	/** Defaults to the virtual module's export (the route need not thread it through). */
	mediaManifest?: MediaManifest | null;
}

const { step, model, staleness, renderManifest } = Astro.props;
// `virtual-model.d.ts` predates `mediaManifest`; read the export structurally.
const mediaManifest: MediaManifest | null =
	Astro.props.mediaManifest ?? (docsi as { mediaManifest?: MediaManifest | null }).mediaManifest ?? null;
const base = import.meta.env.BASE_URL;
const hosting = model.config.hosting;

// A render is shown as an image only when its resolved output IS one: a
// hand-exported component's derived `.stl`/`.step`/`.3mf` gets a 3D viewer (when
// a `.glb`/`.gltf` exists beside it) or a download link instead of a broken
// `<img>`. See `renderPresentation`.
const renders = step.renders.map((render) => {
	const found = renderJobFor(model, renderManifest, render.component, render.id, {
		annotate: render.annotate,
		explode: render.explode,
		format: render.format,
		view: render.view,
	});
	const presentation = found?.job ? renderPresentation(found.job, model.components.get(render.component), base) : undefined;
	return {
		render,
		presentation,
		caption: `${componentName(model, render.component)} — ${render.view}${render.explode ? ', exploded' : ''}`,
	};
});

const viewer = step.viewer
	? (() => {
			const found = renderJobFor(model, renderManifest, step.viewer.component, 'viewer', { format: step.viewer.format });
			return { component: step.viewer.component, url: found?.job ? renderUrl(found.job, base) : undefined };
		})()
	: undefined;

const mediaItems = (step.media ?? []).flatMap((id) => {
	const media = model.media.get(id);
	const entry = staleness[id];
	return media && entry ? [{ media, entry }] : [];
});
// STALE media is demoted below the renders and in-flow media; the text pane follows in the grid.
const inFlow = mediaItems.filter((m) => m.entry.status !== 'STALE');
const stale = mediaItems.filter((m) => m.entry.status === 'STALE');
---

{
	renders.map(({ render, presentation, caption }) =>
		presentation ? (
			<figure class="docsi-render" data-render={render.id} data-kind={presentation.kind}>
				{presentation.kind === 'image' && <img src={presentation.url} alt={render.id} />}
				{presentation.kind === 'model' && (
					<docsi-model data-src={presentation.url}>
						<a href={presentation.url}>Download 3D model</a>
					</docsi-model>
				)}
				{presentation.kind === 'download' && (
					<a class="docsi-download" href={presentation.url}>Download {presentation.filename}</a>
				)}
				<figcaption>{presentation.kind === 'download' ? render.id : caption}</figcaption>
			</figure>
		) : (
			<p class="docsi-render-missing" data-render={render.id}>
				Render “{render.id}” of {componentName(model, render.component)} has not been produced yet.
			</p>
		)
	)
}
{
	viewer &&
		(viewer.url ? (
			<docsi-model data-src={viewer.url}>
				<a href={viewer.url}>Download 3D model</a>
			</docsi-model>
		) : (
			<p class="docsi-render-missing" data-render="viewer">
				3D model of {componentName(model, viewer.component)} has not been produced yet.
			</p>
		))
}
{
	inFlow.map(({ media, entry }) =>
		media.type === 'video' ? (
			<VideoBlock media={media} entry={entry} model={model} hosting={hosting} base={base} mediaManifest={mediaManifest} mode="flow" />
		) : (
			<MediaItem media={media} entry={entry} model={model} hosting={hosting} base={base} />
		)
	)
}
{
	stale.map(({ media, entry }) => (
		<StalenessDetails media={media} entry={entry} model={model} hosting={hosting} base={base} mediaManifest={mediaManifest} />
	))
}
