---
import type { ProjectModel, Step } from '@docsandeye/core';
import { componentName } from '../view.ts';

interface Props {
	step: Step;
	model: ProjectModel;
}

const { step, model } = Astro.props;
---

{
	step.parts.length > 0 && (
		<section class="docsi-parts">
			<h2>Parts</h2>
			<ul>
				{step.parts.map((part) => (
					<li data-component={part.component} data-qty={part.qty} data-cat={part.cat}>
						<span class="docsi-qty">{part.qty}×</span>
						<span class="docsi-part-name">{componentName(model, part.component)}</span>
						<span class="docsi-cat">{part.cat}</span>
					</li>
				))}
			</ul>
		</section>
	)
}
{
	step.tools.length > 0 && (
		<section class="docsi-tools">
			<h2>Tools</h2>
			<ul>
				{step.tools.map((tool) => (
					<li data-component={tool.component} data-qty={tool.qty} data-cat={tool.cat}>
						<span class="docsi-qty">{tool.qty}×</span>
						<span class="docsi-part-name">{componentName(model, tool.component)}</span>
						<span class="docsi-cat">{tool.cat}</span>
					</li>
				))}
			</ul>
		</section>
	)
}
