---
import { stepsForGuide, type Guide, type ProjectModel, type StalenessReport, type Step } from '@docsandeye/core';
import { describeWhen, itemsForGuide, wrapWhenBlocks } from '@docsandeye/core/interactive';
import { asideMarkdown } from '../asides.ts';
import * as docsi from 'virtual:docsandeye/model';
import type { CarbonReport, MediaManifest, RenderManifest } from '../data.ts';
import { glossaryLinker, onlyIf, skipTargets, whenAttr } from '../interactive-view.ts';
import { linkOptionsFor } from '../links.ts';
import { renderMarkdown } from '../markdown.ts';
import { carbonFor, guideHref, olderVideoSentence } from '../view.ts';
import CarbonFigure from './CarbonFigure.astro';
import Checks from './Checks.astro';
import ConsentBar from './ConsentBar.astro';
import ConsentNotice from './ConsentNotice.astro';
import MediaPane from './MediaPane.astro';
import PartsList from './PartsList.astro';
import ProfileData from './ProfileData.astro';
import ProfileForm from './ProfileForm.astro';
import ProfileSummary from './ProfileSummary.astro';
import Receipt from './Receipt.astro';
import StalenessDetails from './StalenessDetails.astro';

interface Props {
	guide: Guide;
	step: Step;
	model: ProjectModel;
	staleness: StalenessReport;
	renderManifest: RenderManifest | null;
	carbon: CarbonReport | null;
	buildDate: string;
	maintainer: boolean;
	pathname: string;
}

const { guide, step, model, staleness, renderManifest, carbon, maintainer, pathname } = Astro.props;
const base = import.meta.env.BASE_URL;
// Only the questions that belong to this guide (`profile[].guides`).
const profile = itemsForGuide(model.config.profile, guide.id);
// Glossary terms: the first occurrence per block (the body, each check, the receipt) becomes a tip button.
const linkTerms = glossaryLinker(model.glossary);
// `<!-- when … -->` blocks become labelled `<div class="docsi-when">`s; a body
// whose comments cannot be read renders unwrapped (`docsandeye check` reports it).
// Repo-relative links: a step of this guide → its page; other project paths → GitHub (`project.repo`).
const links = linkOptionsFor(step, guide, stepsForGuide(model, guide.id), model.config.project, base);
const html = linkTerms(await renderMarkdown(wrapWhenBlocks(step.body, profile).markdown, links));
// The `safety` note is a Starlight danger aside titled "Safety", at the top of the step body: read before anything is done.
const safetyHtml = step.safety ? await renderMarkdown(asideMarkdown('danger', 'Safety', step.safety), links) : undefined;
const carbonEntry = carbonFor(carbon, pathname);
const overview = guideHref(guide, base);
const stepCondition = onlyIf(step.when, profile);
const next = step.when ? skipTargets(stepsForGuide(model, guide.id), step.id, guide, base) : [];
// A STALE video leaves the top of the page: the fresh text and renders lead,
// and the video moves to an "Older video" section at the bottom.
const media = (step.media ?? []).flatMap((id) => {
	const item = model.media.get(id);
	const entry = staleness[id];
	return item && entry ? [{ media: item, entry }] : [];
});
const olderVideos = media.filter((m) => m.media.type === 'video' && m.entry.status === 'STALE');
// `virtual-model.d.ts` predates `mediaManifest`; read the export structurally (as MediaPane does).
const mediaManifest: MediaManifest | null = (docsi as { mediaManifest?: MediaManifest | null }).mediaManifest ?? null;
const hasMediaPane = step.renders.length > 0 || step.viewer !== undefined || media.length > olderVideos.length;
---

<div class="not-content docsi-step-wrap" id="_top" data-guide={guide.id}>
	<ProfileData items={profile} />
	<docsi-step data-step={step.id}>
		{
			hasMediaPane && (
				<div class="docsi-media">
					<MediaPane step={step} model={model} staleness={staleness} renderManifest={renderManifest} olderVideosBelow />
				</div>
			)
		}
		<div class="docsi-text">
			<h1>{step.title}</h1>
			{profile.length > 0 && <ProfileSummary guideId={guide.id} href={overview} />}
			<ConsentNotice />
			{stepCondition && <p class="docsi-when-label docsi-step-condition">{stepCondition}</p>}
			{
				step.when && (
					<p
						class="docsi-skip-notice"
						role="note"
						data-when={whenAttr(step.when)}
						data-when-mode="unless"
						data-next={JSON.stringify(next)}
						data-guide-href={overview}
						hidden
					>
						This step doesn't apply to your setup ({describeWhen(step.when, profile)}).{' '}
						<a class="docsi-skip-link" href={overview}>
							Back to the guide overview
						</a>
						.
					</p>
				)
			}
			{safetyHtml && <div class="docsi-safety" set:html={safetyHtml} />}
			{step.profile && <ProfileForm guideId={guide.id} items={profile} />}
			<div class="docsi-body sl-markdown-content" set:html={html} />
			{step.receipt && <Receipt guideId={guide.id} stepId={step.id} model={model} items={profile} linkTerms={linkTerms} maintainer={maintainer} />}
			<PartsList step={step} model={model} items={profile} />
			<Checks guideId={guide.id} step={step} model={model} items={profile} linkTerms={linkTerms} maintainer={maintainer} links={links} />
			{
				olderVideos.length > 0 && (
					<section class="docsi-older-video">
						<h2>Older video</h2>
						{olderVideos.map(({ media: video, entry }) => (
							<Fragment>
								<p class="docsi-older-intro">{olderVideoSentence(entry, model)}</p>
								<StalenessDetails
									media={video}
									entry={entry}
									model={model}
									hosting={model.config.hosting}
									base={base}
									mediaManifest={mediaManifest}
									title={step.title}
									open
								/>
							</Fragment>
						))}
					</section>
				)
			}
			<footer class="docsi-meta">
				{carbonEntry && <CarbonFigure gco2e={carbonEntry.gco2e} />}
			</footer>
		</div>
	</docsi-step>
	<ConsentBar />
</div>

<script>
	import '../elements/index.ts';
</script>
