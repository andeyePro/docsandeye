---
/**
 * `<docsi-receipt>`: "count what you received". Without JavaScript: a table
 * of per-unit (and per-kit) quantities, each conditional row labelled, and
 * the supplier contacts. The element replaces it with the reader's own
 * checklist and the missing-parts email. Each table row carries its item's
 * data (`data-per`, `data-qty`, `data-from`, `data-when`, supplier) so the
 * list is not sent twice; the element's own `data-*` attributes carry the
 * receipt config, the contacts (with their emails) and the supplier labels.
 */
import type { ProjectModel } from '@docsandeye/core';
import { guideReceiptItems, onlyIf, plainMailto, staticReceiptGroups, supplierLabels, whenAttr } from '../interactive-view.ts';

interface Props {
	guideId: string;
	model: ProjectModel;
}

const { guideId, model } = Astro.props;
const { config } = model;
const items = guideReceiptItems(model, guideId);
const labels = supplierLabels(model);
const { perUnit, perKit } = staticReceiptGroups(items);
const multiplied = config.receipt?.multiply_by;
const optionCount = Object.keys(labels).length;
const fromText = (from: readonly string[] | undefined) =>
	from === undefined || (optionCount > 0 && from.length >= optionCount) ? 'all' : from.map((v) => labels[v] ?? v).join(', ') || 'none';
const groups = [
	{ caption: multiplied ? `Per unit (multiply by your number of ${multiplied})` : 'Per unit', rows: perUnit },
	{ caption: 'Per kit (does not scale with units)', rows: perKit },
].filter((g) => g.rows.length > 0);
const showFrom = config.receipt?.supplier_from !== undefined;
const contacts = Object.entries(config.contacts).filter(([key]) => key !== 'project');
---

<docsi-receipt
	data-guide={guideId}
	data-config={JSON.stringify(config.receipt ?? {})}
	data-contacts={JSON.stringify(config.contacts)}
	data-supplier-labels={JSON.stringify(labels)}
>
	<section class="docsi-receipt">
		<h2>Count what you received</h2>
		<div class="docsi-receipt-static">
			{
				groups.map((group) => (
					<table class="docsi-receipt-table">
						<caption>{group.caption}</caption>
						<thead>
							<tr>
								<th>Part</th>
								<th>Quantity</th>
								{showFrom && <th>In the package from</th>}
							</tr>
						</thead>
						<tbody>
							{group.rows.map((row) => (
								<tr
									data-component={row.component}
									data-per={row.per}
									data-qty={row.qty}
									data-from={row.from?.join(' ')}
									data-when={whenAttr(row.when)}
									data-supplier-name={row.supplier?.name}
									data-supplier-url={row.supplier?.url}
								>
									<td>
										<span class="docsi-receipt-name">{row.name}</span>
										{row.note && <span class="docsi-receipt-note">{row.note}</span>}
										{row.when && <span class="docsi-when-inline">{onlyIf(row.when, config.profile)}</span>}
									</td>
									<td>{row.qty}</td>
									{showFrom && <td>{fromText(row.from)}</td>}
								</tr>
							))}
						</tbody>
					</table>
				))
			}
			{
				contacts.length > 0 && (
					<p class="docsi-receipt-contacts">
						Missing something? Contact your supplier:{' '}
						{contacts.map(([key, contact], i) => {
							const href = plainMailto(contact);
							return (
								<Fragment>
									{i > 0 && ', '}
									{href ? <a href={href}>{contact.name}</a> : <span>{contact.name}</span>}
									{labels[key] && labels[key] !== contact.name && ` (${labels[key]})`}
								</Fragment>
							);
						})}
						.
					</p>
				)
			}
		</div>
		<div class="docsi-receipt-live" hidden></div>
	</section>
</docsi-receipt>
