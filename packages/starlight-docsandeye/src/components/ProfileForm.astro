---
/**
 * `<docsi-profile>`: the reader's setup form, server-rendered with the
 * defaults so it reads (and tabs) without JavaScript; the element fills in
 * the saved answers, hides the questions the chosen options imply (each
 * field carries `data-profile-field`) and saves changes. A link option
 * (`href`) is a plain link in the radio list, never a radio. An option
 * label's `[text](url)` link reads as plain text inside the `<label>`, and
 * the link itself follows the label as a small "site" link, so clicking the
 * label only ever selects the option.
 */
import { defaultProfile, labelParts, type ProfileItem } from '@docsandeye/core/interactive';
import { siteHref } from '../interactive-view.ts';
import ConsentNotice from './ConsentNotice.astro';

interface Props {
	guideId: string;
	items: readonly ProfileItem[];
}

const { guideId, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const fieldId = (id: string) => `docsi-profile-${id}`;
// The defaults with the default choices' implications applied (an implied checkbox starts ticked).
const defaults = defaultProfile(items);
const parts = (label: string) => labelParts(label).map((p) => (p.href ? { ...p, href: siteHref(p.href, base) } : p));
---

{
	items.length > 0 && (
		<docsi-profile data-guide={guideId} id="docsi-profile">
			<form class="docsi-profile-form" aria-labelledby="docsi-profile-heading">
				<h2 id="docsi-profile-heading">Your setup</h2>
				<p class="docsi-profile-intro">
					Answer once and the guide hides the steps and parts that do not apply to you. You choose whether your answers are saved in this browser.
				</p>
				{items.map((item) =>
					item.type === 'number' ? (
						<p class="docsi-profile-field" data-profile-field={item.id}>
							<label for={fieldId(item.id)}>{item.label}</label>
							<input
								type="number"
								id={fieldId(item.id)}
								name={item.id}
								min={item.min}
								max={item.max}
								step="1"
								inputmode="numeric"
								value={String(defaults[item.id])}
							/>
						</p>
					) : item.type === 'boolean' ? (
						<p class="docsi-profile-field docsi-profile-check" data-profile-field={item.id}>
							<input type="checkbox" id={fieldId(item.id)} name={item.id} checked={defaults[item.id] === true} />
							<label for={fieldId(item.id)}>{item.label}</label>
						</p>
					) : (
						<fieldset class="docsi-profile-field" data-profile-field={item.id}>
							<legend>{item.label}</legend>
							{(item.options ?? []).map((option) =>
								option.href !== undefined ? (
									<a class="docsi-profile-option docsi-profile-link" href={siteHref(option.href, base)} data-option={option.value}>
										{parts(option.label).map((p) => p.text).join('')}
									</a>
								) : (
									<span class="docsi-profile-option">
										<label>
											<input type="radio" name={item.id} value={option.value} checked={option.value === defaults[item.id]} />{' '}
											{parts(option.label).map((p) => p.text).join('')}
										</label>
										{parts(option.label)
											.filter((p) => p.href !== undefined)
											.map((p) => (
												<a class="docsi-profile-site" href={p.href} aria-label={`${p.text} (site)`}>
													site
												</a>
											))}
									</span>
								)
							)}
						</fieldset>
					)
				)}
				<p class="docsi-profile-saved" role="status" hidden>The guide now shows what applies to your setup.</p>
				<ConsentNotice />
			</form>
			<noscript>
				<p class="docsi-note">Without JavaScript the guide shows every step; conditional parts are labelled “Only if”.</p>
			</noscript>
		</docsi-profile>
	)
}
