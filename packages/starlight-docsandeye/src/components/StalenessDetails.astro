---
/**
 * A STALE media item, demoted into a `<details>`: the summary names what changed,
 * the changelog entries follow, then the media. A stale video is further gated
 * behind a `Watch the older video` button (`.docsi-stale-video`); the `<noscript>`
 * download link sits after the hidden box so it stays reachable without JavaScript.
 */
import type { HostingConfig, Media, ProjectModel, StalenessEntry } from '@docsandeye/core';
import type { MediaManifest } from '../data.ts';
import { componentName, staleSummary } from '../view.ts';
import MediaItem from './MediaItem.astro';
import VideoBlock from './VideoBlock.astro';

interface Props {
	media: Media;
	entry: StalenessEntry;
	model: ProjectModel;
	hosting: HostingConfig;
	base: string;
	mediaManifest?: MediaManifest | null;
}

const { media, entry, model, hosting, base, mediaManifest = null } = Astro.props;
const isVideo = media.type === 'video';
const summary = staleSummary(media, entry, model);
const changelog = entry.stale_heroes.flatMap((hero) =>
	hero.changelog.map((e) => ({ ...e, component: componentName(model, hero.component) }))
);
---

<details class={isVideo ? 'docsi-stale docsi-stale-video' : 'docsi-stale'}>
	<summary>{summary}</summary>
	{
		changelog.length > 0 && (
			<ul class="docsi-changelog">
				{changelog.map((e) => (
					<li>
						<code>{e.version}</code> <time datetime={e.date}>{e.date}</time> — {e.component}: {e.note}
					</li>
				))}
			</ul>
		)
	}
	{
		isVideo ? (
			<>
				<button type="button" class="docsi-watch-older">Watch the older video</button>
				<VideoBlock media={media} entry={entry} model={model} hosting={hosting} base={base} mediaManifest={mediaManifest} mode="older" />
			</>
		) : (
			<MediaItem media={media} entry={entry} model={model} hosting={hosting} base={base} />
		)
	}
</details>
