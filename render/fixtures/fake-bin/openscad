#!/bin/sh
# Fake `openscad` used by the docsandeye_render test-suite.
#
# Contract (see .vs/spec.md, fixtures section):
#   * `--version` anywhere in argv -> print a version banner on stderr, exit 0.
#   * $DOCSI_FAKE_OPENSCAD_FAIL set -> print `fake failure` on stderr, exit 1.
#   * otherwise -> append one JSON object per invocation, on one line, to the
#     file named by $DOCSI_FAKE_OPENSCAD_LOG, create the file named by `-o`
#     with the content `fake-openscad-output`, and exit 0.

set -u

for arg in "$@"; do
    if [ "$arg" = "--version" ]; then
        echo "OpenSCAD version 2025.03.15" >&2
        exit 0
    fi
done

if [ -n "${DOCSI_FAKE_OPENSCAD_FAIL-}" ]; then
    echo "fake failure" >&2
    exit 1
fi

# JSON-escape a single string: backslash first, then double quote.
esc() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

argv_json=''
out_file=''
take_next=0
first=1
for arg in "$@"; do
    if [ "$take_next" -eq 1 ]; then
        out_file="$arg"
        take_next=0
    fi
    if [ "$arg" = "-o" ]; then
        take_next=1
    fi
    escaped=$(esc "$arg")
    if [ "$first" -eq 1 ]; then
        argv_json="\"$escaped\""
        first=0
    else
        argv_json="$argv_json, \"$escaped\""
    fi
done

cwd_json=$(esc "$(pwd)")

if [ -n "${OPENSCADPATH+set}" ]; then
    openscadpath_json="\"$(esc "$OPENSCADPATH")\""
else
    openscadpath_json='null'
fi

if [ -n "${DOCSI_FAKE_OPENSCAD_LOG-}" ]; then
    printf '{"argv": [%s], "cwd": "%s", "env": {"OPENSCADPATH": %s}}\n' \
        "$argv_json" "$cwd_json" "$openscadpath_json" \
        >> "$DOCSI_FAKE_OPENSCAD_LOG"
fi

if [ -n "$out_file" ]; then
    printf '%s' 'fake-openscad-output' > "$out_file"
fi

exit 0
