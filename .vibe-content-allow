# vibe content-guard allowlist: one whole-line ERE per line.
# Suppresses the mdns WARN on the runtime-config line of the vibe-managed .gitignore block.
^\.claude/settings\.local\.json$
# harness state and worktrees: component@version keys look like emails to the WARN scanner
path-warn:.vs/*
path-warn:.claude/worktrees/*
path-warn:render/fixtures/*
path-warn:packages/*/fixtures/*
path-warn:packages/*/test/*
path-warn:render/tests/*
# RFC 2606 reserved .invalid addresses in the example guide's contacts and the docs (never deliverable)
^.*[A-Za-z0-9._-]+@example\.invalid.*$
