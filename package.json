{
  "name": "docsandeye",
  "private": true,
  "version": "0.1.0",
  "description": "Docs&I monorepo: versioned hardware documentation tooling",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site",
    "examples/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build -w @docsandeye/core && npm run build -w @docsandeye/themes -w starlight-docsandeye -w docsandeye && npm run build -w docsandeye-site --ignore-scripts",
    "typecheck": "tsc --noEmit -p packages/core",
    "e2e": "node packages/starlight-docsandeye/e2e/build-fixture.mjs && playwright test -c packages/starlight-docsandeye/e2e/playwright.config.ts",
    "typecheck:e2e": "tsc -p packages/starlight-docsandeye/e2e"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
